# TEXSETU ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env for local configuration

# Active Spring Profile (dev or prod)
SPRING_PROFILES_ACTIVE=dev

# Server Port
PORT=8080

# Database Configuration (PostgreSQL / Supabase)
# For dev profile, an embedded H2 database (PostgreSQL mode) is used by default if these are not set.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/texsetu
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Supabase Storage Configuration (Optional - Local storage fallback is used if empty)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-or-service-key
SUPABASE_BUCKET=texsetu-documents

# Admin Initial Seed Credentials
TEXSETU_ADMIN_EMAIL=admin@texsetu.com
TEXSETU_ADMIN_PASSWORD=Admin@TexSetu2026!
